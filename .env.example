# PostgreSQL Database URL (Optional: defaults to local fallback storage if not provided)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/growwpulse

# Authentication secret for JWT session tokens
AUTH_SECRET=supersecret-session-key-must-be-at-least-32-chars-long

# Brevo (Sendinblue) Transactional Email Configuration
BREVO_API_KEY=xkeysib-your-actual-brevo-api-key-here
BREVO_SENDER_EMAIL=mail@sukhad.dev
BREVO_SENDER_NAME=GrowwPulse

# Web Push Notification Configuration (Optional)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:mail@sukhad.dev

# Optional Market Data API Key (e.g. Twelve Data, Alpha Vantage)
MARKET_DATA_API_KEY=

# Node Environment
NODE_ENV=development

